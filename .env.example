# Live fares (Travelpayouts). Leave empty to use estimates only.
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
# Set to 1 to return fake fares in dev
FARE_MOCK=1
# Neon Postgres connection string (polls + synced trips). Tables are created on first use.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Sign-in with Google (Auth.js). Create an OAuth client in Google Cloud and add these redirect URIs:
#   http://localhost:3100/api/auth/callback/google
#   https://YOUR-APP.vercel.app/api/auth/callback/google
# AUTH_SECRET: any long random string (npx auth secret).
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# AI guide generation (npm run guides:generate). Any OpenAI-compatible API.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1

# Destination photos (https://unsplash.com/developers). Server-side only; results are cached for a week.
UNSPLASH_ACCESS_KEY=
